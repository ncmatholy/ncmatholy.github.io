{% extends "page.j2" %}
{% set active_page = 'staff' %}
{% set page_title = "Our team" %}
{% set page_desc = "Meet the leadership and test solvers who bring NC(J)MO to life." %}
{% block content %}
    <p class="content-note">These biographies are retained from the existing website. School years and time-sensitive details may need an update.</p>

    <section class="section-space" aria-labelledby="leadership">
        <div class="prose">
            <h2 class="section-title" id="leadership">Leadership</h2>
            <p>Our leadership consists of experienced math olympians from NC. In addition to fulfilling our leadership roles, we all write problems to be selected for the tests.</p>
        </div>
        <div class="team-grid">
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">AC</span>
                <h3 class="team-name">Alan Cheng</h3>
                <p class="team-role">Co-Head of Durham Site</p>
                <p class="team-bio">
                    Alan is a junior from Cary, NC and attends the North Carolina School of Science and Math.
                    He represented NC at MATHCOUNTS Nationals in 2021 and 2022, placed Top 5 at the NC State Math Contest in 2023 and 2024,
                    and was invited to the Math Olympiad Summer Program (MOP) and Canada / USA Mathcamp in 2024.
                    Alan is also a nationally acclaimed rock climber.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">JL</span>
                <h3 class="team-name">Jason Lee</h3>
                <p class="team-role">Co-Director</p>
                <p class="team-bio">
                    Jason is a homeschooled freshman from Durham, NC.
                    Before NCMO, he started the <a href="https://aops.com/community/p29479389" target="_blank" rel="noopener" aria-describedby="new-tab-note">Winter Math Competitions</a> and ran it from 2021 to 2024.
                    He also inspired the creation of the <a href="https://aops.com/community/p30801609" target="_blank" rel="noopener" aria-describedby="new-tab-note">Washington Math Olympiad</a>,
                    testsolved for <a href="https://benny-w.github.io/ZeMC/" target="_blank" rel="noopener" aria-describedby="new-tab-note">Ze Math Competitions</a>,
                    and wrote the power round of the <a href="http://www.explorechina.cn/asdan-maths-tournament/" target="_blank" rel="noopener" aria-describedby="new-tab-note">ASDAN Math Tournament</a> in 2022.
                    Outside of math, Jason enjoys music, robotics, mock trial, teaching, and attempting to write.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">GP</span>
                <h3 class="team-name">Grisham Paimagam</h3>
                <p class="team-role">Co-Director and Head of Charlotte Site</p>
                <p class="team-bio">
                    Grisham is a sophomore from Charlotte, NC and attends Myers Park High School, where he is the math club head.
                    He has been actively participating in math contests for around 3 years, and has recently started math research as well.
                    Outside of math, Grisham is an avid squash player and is top 50 for his age group nationally, and loves to play basketball and football for fun.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">AW</span>
                <h3 class="team-name">Aaron Wang</h3>
                <p class="team-role">Co-Head of Durham Site</p>
                <p class="team-bio">
                    Aaron is a junior from Charlotte, NC and attends the North Carolina School of Science and Math.
                    He is famous for rederiving the circumcenter of a right triangle in his (correct) in-contest solution
                    to <a href="https://aops.com/community/p30227196" target="_blank" rel="noopener" aria-describedby="new-tab-note">USAMO 2024/5</a>, which just so happened to qualify him for MOP.
                    Aaron enjoys playing tennis and piano.
                </p>
            </article>
        </div>
    </section>

    <section class="section-space" aria-labelledby="test-solvers">
        <div class="prose">
            <h2 class="section-title" id="test-solvers">Test solvers</h2>
            <p>Our test solvers come from many different backgrounds, and include MOPpers, NC vets, WAMO staff, and more.</p>
        </div>
        <div class="team-grid">
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">JL</span>
                <h3 class="team-name">Jordan Lefkowitz</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    Jordan Lefkowitz is a college freshman from Connecticut and attends the Massachusetts Institute of Technology.
                    You may have heard of him before.
                    (Hint: he competed at the International Math Olympiad.)
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">AL</span>
                <h3 class="team-name">Alex Liu</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    Alex is a sophomore from Apex, NC and attends Green Level High School.
                    He is extraordinarily skilled at tetris.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">JL</span>
                <h3 class="team-name">Jiahe Liu</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    Jiahe is a junior from Ohio and attends Beachwood High School.
                    He placed first written at MATHCOUNTS Nationals 2022 and qualified for MOP in 2023 and 2024.
                    Jiahe is particularly fond of the blobheart emoji.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">VS</span>
                <h3 class="team-name">Vikram Sarkar</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    Vikram is a junior from Connecticut and attends the Brunswick School.
                    He qualified for MOP 2024 and USA Team Selection for IMO 2025.
                    In his free time, Vikram enjoys bashing geometry and solving algebra or number theory.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">BW</span>
                <h3 class="team-name">Benny Wang</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    Benny is a junior from Illinois and attends the Phillips Exeter Academy.
                    In 2023, he tragically missed MOP by misreading <a href="https://aops.com/community/p27349258" target="_blank" rel="noopener" aria-describedby="new-tab-note">JMO/1</a>,
                    but bounced back to qualify for MOP 2024!
                    He also founded and directed the aforementioned <a href="https://benny-w.github.io/ZeMC/" target="_blank" rel="noopener" aria-describedby="new-tab-note">Ze Math Competitions</a>,
                    and currently writes for <a href="https://exetermathclub.com/" target="_blank" rel="noopener" aria-describedby="new-tab-note">his school's competition</a>.
                    Twice a year, Benny solves an AMC problem on <a href="https://www.youtube.com/@confusion5025" target="_blank" rel="noopener" aria-describedby="new-tab-note">his youtube channel</a>.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">LW</span>
                <h3 class="team-name">Laura Wang</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    Laura is a freshman from Washington and attends the Lakeside School.
                    She is a 2024 MATHCOUNTS National Countdown Round Semifinalist and tied for the second highest score at the 2024 Math Prize for Girls.
                    Additionally, Laura writes problems for the Washington Math Olympiad.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">OW</span>
                <h3 class="team-name">Oron Wang</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    Oron is a sophomore from New Jersey and attends the Phillips Exeter Academy.
                    His talents include <a href="https://youtube.com/watch?v=x9lE7677ido" target="_blank" rel="noopener" aria-describedby="new-tab-note">improvising on the piano</a>,
                    <a href="https://www.youtube.com/watch?v=zteGhJIFqqk" target="_blank" rel="noopener" aria-describedby="new-tab-note">intermediate minesweeper</a>,
                    and <a href="https://aops.com/community/h3382222" target="_blank" rel="noopener" aria-describedby="new-tab-note">postmodern geometry</a>.
                    He also happened to place 2nd on the USA Team Selection Test Selection Test for IMO 2025.
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">AY</span>
                <h3 class="team-name">Allan Yuan</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    In 2022, he won MATHCOUNTS Nats.
                    In 2023, he made MOP.
                    In 2024, he started robbing ankles 😭
                </p>
            </article>
            <article class="team-card">
                <span class="team-initials" aria-hidden="true">BZ</span>
                <h3 class="team-name">Brian Zhang</h3>
                <p class="team-role">Test solver</p>
                <p class="team-bio">
                    I don't think he needs any introduction. :)
                </p>
            </article>
        </div>
    </section>
{% endblock %}
