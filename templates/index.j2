{% extends "base.j2" %}
{% set active_page = 'home' %}
{% block header %}
<section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
        <h1 id="hero-title">North Carolina<br><span class="hero-title-accent">(Junior) Math Olympiad</span></h1>
        <p class="hero-intro">Two proof-based math competitions: NCJMO and NCMO. Explore past problems, write proofs, and discover new ideas.</p>
        <section class="registration-placeholder" aria-labelledby="registration-title">
            <h2 id="registration-title">Registration</h2>
            <p>Dates and signup details for the next contest will appear here when announced.</p>
        </section>
        <div class="hero-actions"><a class="button" href="/archive/">Explore past problems <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a><a class="text-link" href="/about/">Meet the contest <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M3 10h14M11 4l6 6-6 6"/></svg></a></div>
        <p class="edition-note"><span class="status-dot" aria-hidden="true"></span> The 2026 contest has concluded. <a href="/archive/#year-2026">Results &amp; solutions are here <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a></p>
    </div>
    <div class="hero-art" aria-hidden="true"><img src="{{ static_asset('geometry.svg') }}" alt="" width="560" height="560"></div>
</section>
{% endblock %}
{% block main %}
<div class="container">
    <section class="contest-facts" aria-label="Contest at a glance">
        <div><span class="fact-number">05<span>.</span></span><p>Proof problems</p></div>
        <div><span class="fact-number">03<span>.</span></span><p>Hours to think</p></div>
        <div><span class="fact-number">02<span>.</span></span><p>Divisions</p></div>
    </section>
    <section class="section-space year-section" aria-labelledby="edition-title">
        <div class="section-heading"><div><h2 id="edition-title">2026 results</h2></div></div>
        <a class="edition-card" href="/archive/#year-2026"><div><h3>2026 problems,<br>results &amp; solutions</h3></div><div class="edition-drawing" aria-hidden="true"><svg viewBox="0 0 220 180"><path d="M151 155H35V25h130v115 M126 126H64V54h72v60 M109 101H89V79h22v17"/><path class="proof-corner" d="M152 142h13v13h-13Z"/></svg></div><span class="round-arrow" aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></span></a>
        <details class="historical-details"><summary>Past contest: 2026 schedule &amp; updates<span class="details-plus" aria-hidden="true">+</span></summary><div class="historical-content"><p>The NC(J)MO 2026 has concluded. The schedule below is retained for reference; it is not an announcement of an upcoming contest.</p><div class="table-wrap"><table><caption>January 2026 contest schedule</caption><thead><tr><th scope="col">Site</th><th scope="col">Format</th><th scope="col">Date</th><th scope="col">Time</th></tr></thead><tbody><tr><th scope="row">Triangle</th><td>Online</td><td>January 24</td><td>2:00 PM–5:00 PM</td></tr><tr><th scope="row">Charlotte</th><td>Online</td><td>January 24</td><td>2:00 PM–5:00 PM</td></tr><tr><th scope="row">NCSSM Durham</th><td>Online</td><td>January 24</td><td>2:00 PM–5:00 PM</td></tr><tr><th scope="row">Online</th><td>Online</td><td>January 25</td><td>1:00 PM–4:00 PM</td></tr></tbody></table></div><p><strong>Original site update:</strong> A heavy snowstorm forecast for January 24 moved the Charlotte and Triangle sites online. The NCSSM Durham site also moved online when NCSSM shifted to condition 2.</p><p class="content-note">The earlier homepage said “Grading is in progress.” The archive now includes the existing 2026 results-and-solutions document. No future contest dates have been announced on this site.</p></div></details>
    </section>
    <section class="section-space starting-section" aria-labelledby="start-title">
        <div class="section-heading"><div><h2 id="start-title">Choose your division</h2></div><a class="text-link" href="/about/#divisions">Find your division <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a></div>
        <div class="division-grid">
            <article class="division-card"><div class="division-card-top"><span class="division-symbol" aria-hidden="true">∑</span></div><h3>NCJMO (Junior)</h3><p>New to proofs or exploring beyond school math? The NCJMO is an invitation to try, experiment, and explain your ideas.</p><a class="text-link" href="/archive/?division=NCJMO">Explore NCJMO problems <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a></article>
            <article class="division-card"><div class="division-card-top"><span class="division-symbol" aria-hidden="true">∞</span></div><h3>NCMO (Olympiad)</h3><p>Comfortable with the AIME or have some proof-writing experience? Challenge yourself with the NCMO.</p><a class="text-link" href="/archive/?division=NCMO">Explore NCMO problems <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a></article>
        </div>
    </section>
    <section class="community-section" aria-labelledby="community-title"><h2 id="community-title">Our math community</h2><p>We believe thoughtful, creative problem-solving belongs to everyone. Meet the people making proof-based math more accessible.</p><a class="text-link" href="/staff/">Meet our team <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a><img class="community-accent" src="{{ static_asset('spark.svg') }}" alt=""></section>
</div>
{% endblock %}
