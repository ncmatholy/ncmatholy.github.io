{% set reg_link = "https://forms.gle/57ULZhRrbpaL4ZLq9" %}
{% set active_page = active_page | default("") %}
{% from "marks.j2" import proof_mark %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f5ee">
    <script src="{{ static_asset('theme.js') }}"></script>
    <meta name="description" content="{% block description %}North Carolina (Junior) Math Olympiad offers two proof-based math competitions: NCJMO and NCMO. Find contest information, rules, past problems, and results.{% endblock %}">
    <title>{% block title %}NC(J)MO — North Carolina Math Olympiad{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ static_asset('mark.svg') }}">
    <link rel="preload" href="/static/fonts/lora-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/static/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ static_asset('site.css') }}">
    <script src="{{ static_asset('site.js') }}" defer></script>
    {% if active_page == 'contact' %}<script src="{{ static_asset('contact.js') }}" defer></script>{% endif %}
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <span id="new-tab-note" class="sr-only">Opens in a new tab.</span>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="NC(J)MO home">{{ proof_mark(34) }}<span>NC(J)MO<span class="brand-period" aria-hidden="true">.</span></span></a>
            <div class="header-tools">
                <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode" hidden>
                    <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.2 14.3A8.5 8.5 0 0 1 9.7 3.8 8.5 8.5 0 1 0 20.2 14.3Z"/></svg>
                    <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </button>
                <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden><span class="menu-label">Menu</span><span class="menu-lines" aria-hidden="true"></span></button>
            </div>
            <nav id="site-nav" class="site-nav" aria-label="Main navigation">
                <a href="/about/"{% if active_page == 'about' %} aria-current="page"{% endif %}>About the contest</a>
                <a href="/archive/"{% if active_page == 'archive' %} aria-current="page"{% endif %}>Past problems</a>
                <a href="/staff/"{% if active_page == 'staff' %} aria-current="page"{% endif %}>Our team</a>
                <a class="nav-contact" href="/contact/"{% if active_page == 'contact' %} aria-current="page"{% endif %}>Contact <svg class="mail-icon" aria-hidden="true" viewBox="0 0 20 20"><rect x="2" y="4" width="16" height="12" rx="2"/><path d="m3 5 7 5 7-5"/></svg></a>
            </nav>
        </div>
    </header>
    <main id="main" tabindex="-1">
        {% block header %}{% endblock %}
        {% block main %}<div class="container page-content">{% block content %}{% endblock %}</div>{% endblock %}
    </main>
    <footer class="site-footer">
        <div class="container footer-top"><div><p class="footer-title">Past problems</p></div><a class="button button-light" href="/archive/">Browse the archive <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a></div>
        <div class="container footer-bottom">
            <div><a class="footer-brand" href="/">NC(J)MO.</a><p>North Carolina (Junior) Math Olympiad</p><p class="footer-contact"><a href="mailto:ncmatholy@gmail.com">ncmatholy@gmail.com</a></p></div>
            <nav aria-label="Footer navigation"><a href="/about/">About</a><a href="/about/#rules-scoring">Rules &amp; scoring</a><a href="/archive/">Archive</a><a href="/staff/">Team</a><a href="/contact/">Contact</a></nav>
            <p class="footer-edition">2026 edition<br><a href="{{ reg_link }}" target="_blank" rel="noopener" aria-describedby="new-tab-note">Original registration form <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a><span class="footer-form-note">The 2026 contest has concluded.</span></p>
        </div>
    </footer>
</body>
</html>
