{% extends "page.j2" %}
{% from "icons.j2" import link_arrow %}
{% set active_page = 'archive' %}
{% set page_title = 'Past problems' %}
{% set page_desc = 'Browse NCMO and NCJMO problems by year. Results and solutions cover both divisions.' %}
{% set editions = [(2026, 'c4712972', 'c4712973', 'c5h3752861'), (2025, 'c4166369', 'c4167328', 'c5h3467015')] %}
{% block content %}
<div class="archive-toolbar" data-archive-controls hidden>
    <div class="division-filters" role="group" aria-label="Filter by division"><button type="button" data-filter="all" aria-pressed="true">All divisions</button><button type="button" data-filter="NCJMO" aria-pressed="false">NCJMO</button><button type="button" data-filter="NCMO" aria-pressed="false">NCMO</button></div>
    <label class="year-filter" for="archive-year">Year <select id="archive-year"><option value="all">All years</option>{% for year, _, _, _ in editions %}<option value="{{ year }}">{{ year }}</option>{% endfor %}</select></label>
</div>
<p class="sr-only" data-archive-count aria-live="polite" aria-atomic="true">{{ (editions | length) * 3 }} documents · {{ editions | length }} years</p>
<div class="archive-years">
{% for year, olympiad_collection, junior_collection, post in editions %}
<section class="archive-year" id="year-{{ year }}" data-year="{{ year }}" aria-labelledby="year-heading-{{ year }}">
    <div class="archive-year-heading"><h2 id="year-heading-{{ year }}">{{ year }}<span class="year-dot">.</span></h2><a class="text-link" href="https://aops.com/community/{{ post }}" target="_blank" rel="noopener" aria-describedby="new-tab-note">AoPS Post {{ link_arrow(true) }}<span class="sr-only"> — {{ year }}</span></a></div>
    {% for division, collection in [('NCMO', olympiad_collection), ('NCJMO', junior_collection)] %}
    <article class="document-row" data-division="{{ division }}"><span class="document-figure" aria-hidden="true"><svg class="document-icon" viewBox="0 0 24 24">{% if division == 'NCMO' %}<path d="M12 2 20.66025404 17H3.33974596Z"/>{% else %}<circle cx="12" cy="12" r="5.5"/>{% endif %}</svg></span><div class="document-title"><h3>{{ division }}</h3></div><div class="document-actions"><a class="download-link" href="/static/{{ year }}/{{ division }}-{{ year }}.pdf" target="_blank" rel="noopener" aria-describedby="new-tab-note">Open PDF {{ link_arrow(true) }}<span class="sr-only"> — {{ division }} {{ year }} problem set</span></a><a class="aops-link" href="https://aops.com/community/{{ collection }}" target="_blank" rel="noopener" aria-describedby="new-tab-note">On AoPS {{ link_arrow(true) }}<span class="sr-only"> — {{ division }} {{ year }} collection</span></a></div></article>
    {% endfor %}
    <article class="document-row results-row" data-division="both"><span class="document-figure" aria-hidden="true"><svg class="document-icon therefore-icon" viewBox="0 0 24 24"><circle cx="12" cy="7" r="1.7"/><circle cx="7.66987298" cy="14.5" r="1.7"/><circle cx="16.33012702" cy="14.5" r="1.7"/></svg></span><div class="document-title"><h3>Results &amp; solutions</h3></div><div class="document-actions"><a class="download-link" href="/static/{{ year }}/results-solutions-{{ year }}.pdf" target="_blank" rel="noopener" aria-describedby="new-tab-note">Open PDF {{ link_arrow(true) }}<span class="sr-only"> — {{ year }} results and solutions</span></a></div></article>
</section>
{% endfor %}
</div>
{% endblock %}
