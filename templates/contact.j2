{% extends "page.j2" %}
{% set active_page = 'contact' %}
{% set page_title = 'Contact' %}
{% set page_desc = 'Questions about the contest? Send an inquiry to ncmatholy@gmail.com.' %}
{% block content %}
<div class="contact-layout">
    <section class="contact-card" aria-labelledby="contact-form-title">
        <h2 id="contact-form-title">Write an inquiry</h2>
        <p id="contact-compose-note">Choose your email app or Gmail, then review and send your message there.</p>
        <form id="contact-form" class="contact-form" action="mailto:ncmatholy@gmail.com" method="get" aria-describedby="contact-compose-note" hidden>
            <div class="contact-field">
                <label for="contact-subject">Subject</label>
                <input id="contact-subject" name="subject" type="text" value="NC(J)MO inquiry" maxlength="160" autocomplete="off">
            </div>
            <div class="contact-field">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="body" rows="7" maxlength="10000" required></textarea>
            </div>
            <button class="button button-primary" type="submit">Open email app <svg class="mail-icon" aria-hidden="true" viewBox="0 0 20 20"><rect x="2" y="4" width="16" height="12" rx="2"/><path d="m3 5 7 5 7-5"/></svg></button>
        </form>
        <noscript><p>Use the email address or Gmail link below to write your inquiry.</p></noscript>
        <div class="contact-options">
            <a id="gmail-draft-link" class="text-link" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=ncmatholy%40gmail.com&amp;su=NC%28J%29MO%20inquiry" target="_blank" rel="noopener" aria-describedby="new-tab-note contact-compose-note">Open Gmail draft <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M4 4h12v12"/></svg></a>
        </div>
        <p id="contact-draft-status" class="contact-status" role="status" aria-live="polite"></p>
    </section>
    <aside class="contact-details" aria-labelledby="contact-address-title">
        <h2 id="contact-address-title">Email address</h2>
        <p class="contact-email"><a id="contact-email-address" href="mailto:ncmatholy@gmail.com">ncmatholy@gmail.com</a></p>
        <p>You can also write to us directly from your email account.</p>
        <button id="copy-email-address" class="button button-outline" type="button" hidden>Copy email address</button>
        <p id="contact-copy-status" class="contact-status" role="status" aria-live="polite"></p>
    </aside>
</div>
{% endblock %}
